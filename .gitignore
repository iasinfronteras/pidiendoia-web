# ── Dependencias ─────────────────────────────────────────────────────────────
# Dependencias instaladas localmente; se reconstruyen con npm ci.
node_modules/

# ── Build de Astro ───────────────────────────────────────────────────────────
# Artefactos generados por npm run build; no se versionan.
# En producción, stack-web sirve el contenido generado de dist/.
dist/

# ── Cache de Astro y Vite ────────────────────────────────────────────────────
# Archivos temporales generados durante desarrollo y compilación.
.astro/
.vite/

# ── Variables de entorno ─────────────────────────────────────────────────────
# Nunca versionar secretos ni configuración local.
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
# Logs generados por Node, npm y herramientas del proyecto.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Sistema operativo ────────────────────────────────────────────────────────
# Archivos creados automáticamente por el sistema operativo.
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
# Configuración espesifica del entorno de desarrollo..
.vscode/settings.json
.vscode/launch.json

# extensions.json SÍ se versiona: recomendaciones del proyecto para el equipo.
# .vscode/extensions.json
