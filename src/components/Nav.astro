---
/**
 * Nav.astro
 * Barra de navegación global de pidiendoia.com.
 *
 * Responsabilidades:
 * - Mostrar logo, enlaces principales y CTA "Agendar diagnóstico".
 * - Indicar la página activa mediante comparación con Astro.url.pathname.
 * - Comportarse como navbar sticky con fondo sólido en scroll.
 * - En móvil: menú hamburguesa con CTA siempre visible.
 *
 * Restricciones (Especificación Funcional v1.1 — S1.1):
 * - Sin dropdowns en Etapa 1.
 * - CTA siempre visible en mobile, sin necesidad de abrir el menú.
 * - Fondo sólido (no transparente) para legibilidad en scroll.
 */

// ─── Navegación principal ────────────────────────────────────────────────────
const navLinks = [
  { label: 'Casos de uso', href: '/casos-de-uso' },
  { label: 'Demos',        href: '/demos'         },
  { label: 'Servicios',    href: '/servicios'     },
  { label: 'Nosotros',     href: '/nosotros'      },
];

// ─── Página activa ───────────────────────────────────────────────────────────
// Comparamos el inicio del pathname para que rutas anidadas
// (ej. /casos-de-uso/procesamiento-documental) también activen el link correcto.
const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<!--
  Navbar sticky.
  - bg-white + shadow-sm: fondo sólido visible en scroll.
  - z-50: siempre encima del contenido de la página.
-->
<header class="sticky top-0 z-50 bg-white shadow-sm">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >

    <!-- Logo ──────────────────────────────────────────────────────────────── -->
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-bold text-brand-700 hover:text-brand-900 transition-colors"
      aria-label="PidiendoIA — ir al inicio"
    >
      <!-- Placeholder hasta que exista el logo SVG definitivo -->
      <span>PidiendoIA</span>
    </a>

    <!-- Links desktop (ocultos en mobile) ────────────────────────────────── -->
    <ul class="hidden items-center gap-6 md:flex" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-700',
              isActive(link.href)
                ? 'text-brand-700 underline underline-offset-4'
                : 'text-neutral-700',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA desktop + botón hamburguesa mobile ───────────────────────────── -->
    <div class="flex items-center gap-3">

      <!-- CTA — visible siempre, incluso en mobile sin abrir el menú -->
      <a
        href="/contacto?origen=nav"
        class="rounded bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-900 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
      >
        Agendar diagnóstico
      </a>

      <!-- Botón hamburguesa (solo visible en mobile) -->
      <button
        id="nav-toggle"
        type="button"
        class="flex items-center justify-center rounded p-2 text-neutral-700 hover:bg-neutral-200 transition-colors md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <!-- Ícono hamburguesa -->
        <svg
          id="icon-open"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <!-- Ícono cerrar (oculto por defecto) -->
        <svg
          id="icon-close"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú mobile ─────────────────────────────────────────────────────────── -->
  <div
    id="mobile-menu"
    class="hidden border-t border-neutral-200 bg-white md:hidden"
    role="dialog"
    aria-label="Menú de navegación mobile"
  >
    <ul class="flex flex-col px-4 py-3" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block py-3 text-sm font-medium transition-colors hover:text-brand-700',
              isActive(link.href)
                ? 'text-brand-700 underline underline-offset-4'
                : 'text-neutral-700',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<!-- Toggle del menú mobile ──────────────────────────────────────────────── -->
<!--
  Vanilla JS — sin dependencias externas.
  Solo gestiona aria-expanded y visibilidad del menú e íconos.
-->
<script>
  const toggle   = document.getElementById('nav-toggle')   as HTMLButtonElement;
  const menu     = document.getElementById('mobile-menu')  as HTMLDivElement;
  const iconOpen  = document.querySelector<SVGElement>('#icon-open');
  const iconClose = document.querySelector<SVGElement>('#icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden') === false;

    // Actualizar estado aria para accesibilidad
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute(
      'aria-label',
      isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
    );

    // Intercambiar íconos
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
