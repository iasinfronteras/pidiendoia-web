---
/**
 * CasoCard.astro
 * Tarjeta de caso de uso para pidiendoia.com.
 *
 * Responsabilidades:
 * - Presentar un caso de uso con su área, problema y enlace a la página completa.
 * - Aplicar el borde izquierdo brand-700 como elemento de identidad visual (DS-05).
 * - Ser reutilizable en la Home (S1.5) y en /casos-de-uso.
 *
 * Restricciones (RC-01, DS-05):
 * - El texto del problema habla el lenguaje del cliente, sin jerga técnica.
 * - El borde izquierdo brand-700 es exclusivo de este componente.
 * - El enlace lleva siempre a la sub-página del caso, no a /demos directamente.
 *
 * Uso:
 *   <CasoCard
 *     area="Operaciones"
 *     problema="Clasificar y procesar documentos sin digitación manual"
 *     descripcion="Recibimos documentos en PDF y email. Alguien los revisa y los ingresa al sistema a mano."
 *     href="/casos-de-uso/procesamiento-documental"
 *   />
 */

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** Área empresarial del caso: Operaciones, Ventas, Soporte, etc. */
  area: string;

  /** Problema en lenguaje del cliente. Aparece como título de la tarjeta. */
  problema: string;

  /** Descripción breve del problema. 1-2 oraciones máximo. */
  descripcion: string;

  /** URL de la sub-página completa del caso de uso. */
  href: string;

  /** Texto del enlace al final de la tarjeta. */
  linkLabel?: string;
}

const {
  area,
  problema,
  descripcion,
  href,
  linkLabel = 'Ver caso completo →',
} = Astro.props;
---

<!--
  Tarjeta de caso de uso.
  - border-l-4 border-brand-700: identidad visual DS-05.
  - hover:shadow-md: retroalimentación visual sin animaciones complejas.
-->
<article
  class="rounded-lg border border-neutral-200 border-l-4 border-l-brand-700 bg-white p-5 transition-shadow hover:shadow-md"
>

  <!-- Área empresarial ──────────────────────────────────────────────────── -->
  <span class="inline-block rounded bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
    {area}
  </span>

  <!-- Problema (título de la tarjeta) ──────────────────────────────────── -->
  <h3 class="mt-3 text-sm font-semibold leading-snug text-neutral-950">
    {problema}
  </h3>

  <!-- Descripción breve ────────────────────────────────────────────────── -->
  <p class="mt-2 text-sm leading-relaxed text-neutral-700">
    {descripcion}
  </p>

  <!-- Enlace al caso completo ──────────────────────────────────────────── -->
  <a
    href={href}
    class="mt-4 inline-block text-sm font-medium text-brand-700 hover:text-brand-900 transition-colors"
  >
    {linkLabel}
  </a>

</article>
